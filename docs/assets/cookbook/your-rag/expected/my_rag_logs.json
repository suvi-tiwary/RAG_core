{
 "chunks": [
  {
   "id": "c1",
   "text": "# Travel policy",
   "metadata": {
    "source": "travel_policy.md",
    "page": 1
   }
  },
  {
   "id": "c2",
   "text": "Economy class is required for all flights under six hours. Business class is allowed for flights of six hours or longer.",
   "metadata": {
    "source": "travel_policy.md",
    "page": 1
   }
  },
  {
   "id": "c3",
   "text": "The daily meal allowance is 40 euros. Receipts are needed for every meal above 15 euros.",
   "metadata": {
    "source": "travel_policy.md",
    "page": 1
   }
  },
  {
   "id": "c4",
   "text": "Hotels must cost less than 150 euros per night. Book hotels through the company travel portal.",
   "metadata": {
    "source": "travel_policy.md",
    "page": 1
   }
  },
  {
   "id": "c5",
   "text": "Travel must be approved by your manager before booking. Trips abroad also need approval from HR.",
